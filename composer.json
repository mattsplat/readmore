{
    "name": "mattsplat/readmore",
    "description": "A Laravel Nova field that hides long text and reveals it on click.",
    "keywords": [
        "laravel",
        "nova",
        "field",
        "textarea",
        "read-more"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Matt Coleman",
            "email": "matthewjohncoleman@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/nova": "^4.0"
    },
    "require-dev": {
        "laravel/nova-devtool": "^1.0",
        "orchestra/testbench": "^8.24 || ^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Mattsplat\\Readmore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mattsplat\\Readmore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mattsplat\\Readmore\\FieldServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
